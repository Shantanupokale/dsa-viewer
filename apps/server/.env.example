# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).

# Shared invite password gating the whole app (PRD §13). Min 8 chars.
APP_ACCESS_PASSWORD=change-me-to-something-long

# Secret used to sign the auth cookie. Min 16 chars, high-entropy.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-generate-a-random-32-byte-hex-string

# Optional overrides (defaults shown).
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
RUN_TIMEOUT_MS=10000
MAX_CODE_LENGTH=50000
MAX_INPUT_LENGTH=100000
RUN_RATE_MAX=20

# Optional: enables the "AI auto-trace" button (rewrites raw code via Gemini 2.5 Flash).
# Get a key at https://aistudio.google.com/apikey — leave unset to disable the feature.
# GEMINI_API_KEY=


# Comma-separated origin allow-list. Default already covers both loopback spellings —
# only set this if you serve the frontend from somewhere else.
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
